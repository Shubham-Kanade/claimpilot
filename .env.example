# Copy to .env and fill in. Never commit .env.

# --- LLM (System Two). Personal Claude Console workspace with a monthly spend limit.
ANTHROPIC_API_KEY=
# replay (default, $0, VCR cassettes) | live (real calls) | fake (deterministic stub)
LLM_MODE=replay
# Per-route model override (haiku | sonnet | opus); defaults live in services/api/config/models.yaml
# ROUTE_EXTRACTION=haiku
# ROUTE_AGENT_CHAT=sonnet

# --- System One (Jev, TypeSafe AI). Leave empty to use the LLM adapter.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# jev | llm | fake
DECISION_ENGINE=llm

# --- Infra (docker compose defaults)
DATABASE_URL=postgresql+asyncpg://claimpilot:claimpilot@postgres:5432/claimpilot
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
# S3-compatible storage is chosen with hosting on Day 4 (ADR-009); leave empty for the local volume
S3_ENDPOINT_URL=
S3_BUCKET=

# --- Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# --- Guardrails
DAILY_USER_TOKEN_BUDGET=200000
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=10
