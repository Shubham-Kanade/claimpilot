{% extends "_base.html.j2" %}
{# Hand-filled cash memo (kirana / stationery) or auto-rickshaw fare slip. #}
{% block style %}
  #doc {
    width: 520px;
    padding: 22px 26px 28px;
    background-color: #fdfbf3;
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 33px, #b9cbe0 33px, #b9cbe0 34px);
    background-position: 0 6px;
    color: #333;
    font-family: "Noto Sans", "Noto Sans Devanagari", sans-serif;
  }
  .printed { text-align: center; color: #8b1c1c; }
  .shop { font-size: 21px; font-weight: 700; }
  .memo { display: inline-block; border: 1px solid #8b1c1c; padding: 1px 10px; margin-top: 4px; font-size: 12px; font-weight: 700; }
  .hand {
    font-family: "{{ s.font }}", "Kalam", cursive;
    color: {{ s.ink }};
    font-size: {{ 22 if s.font == "Caveat" else 18 }}px;
    line-height: 34px;
    transform: rotate({{ s.tilt }}deg);
  }
  .row { display: flex; justify-content: space-between; }
  .total { border-top: 2px solid {{ s.ink }}; font-weight: 700; margin-top: 4px; }
  .label { font-family: "Noto Sans", "Noto Sans Devanagari", sans-serif; font-size: 12px; color: #8b1c1c; }
  .sig { text-align: right; margin-top: 10px; }
{% endblock %}
{% block content %}
{% if s.kind == "auto" %}
<div class="hand">
  <div class="c" style="font-weight:700">{{ x.title }}</div>
  {% if r.date %}<div><span class="label">Date:</span> {{ r.date | fdate(s.date_style) }}</div>{% endif %}
  <div><span class="label">From:</span> {{ x.from_place }} &nbsp; <span class="label">To:</span> {{ x.to_place }}</div>
  <div><span class="label">Fare:</span> Rs {{ r.total | int }}/-</div>
  <div>{{ x.received_label }} - {{ x.passenger }}</div>
  <div><span class="label">Driver:</span> {{ r.merchant_name }}</div>
  <div><span class="label">Auto No:</span> {{ x.auto_no }}</div>
  {% if x.injection_text %}<div>{{ x.injection_text }}</div>{% endif %}
  <div class="sig">~ {{ r.merchant_name.split()[0] }} ~</div>
</div>
{% else %}
<div class="printed">
  <div class="shop">{{ r.merchant_name }}</div>
  <div style="font-size:12px">{{ x.locality }}, {{ r.merchant_city }} &middot; Mob: {{ x.phone_masked }}</div>
  <div class="memo">{{ x.memo_label }}</div>
</div>
<div class="hand">
  <div class="row"><span><span class="label">No.</span> {{ r.invoice_number }}</span>{% if r.date %}<span><span class="label">Date</span> {{ r.date | fdate(s.date_style) }}</span>{% endif %}</div>
  {% if x.customer %}<div><span class="label">M/s</span> {{ x.customer }}</div>{% endif %}
  {% for item in r.line_items %}
  <div class="row"><span>{{ loop.index }}. {{ item.description }}{% if item.quantity %} &nbsp;{{ item.quantity | int }} x {{ item.unit_price | int }}{% endif %}</span><span>{{ item.amount | int }}/-</span></div>
  {% endfor %}
  <div class="row total"><span>Total</span><span>{{ r.total | int }}/-</span></div>
  {% if x.injection_text %}<div>{{ x.injection_text }}</div>{% endif %}
  <div class="sig">Thank you</div>
</div>
{% endif %}
{% endblock %}
